NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Local MCP OAuth client and Pacemaker API access-token issuer.
MCP_OAUTH_CLIENT_ID=
MCP_API_JWT_ISSUER=http://localhost:3001
MCP_API_JWT_AUDIENCE=urn:pacemaker:admin-api:development
MCP_API_JWT_KEY_ID=local-mcp-2026-01
# RS256 PEM key pair. Keep the private key in the API server environment only.
MCP_API_JWT_PRIVATE_KEY=
MCP_API_JWT_PUBLIC_KEY=

DATABASE_URL=
DIRECT_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not read by the app yet; the server-side client in src/lib/supabase.ts is commented out.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage S3 access (uploads, image proxy, seed and storage scripts).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ca-central-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# Local development uses the -dev buckets only. Production uses image/document.
SUPABASE_S3_IMG_BUCKET=image-dev
SUPABASE_S3_EBOOK_BUCKET=document-dev

# App base URL used when building Stripe success/cancel callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout. Use the same Stripe account as pacemaker-apply.
STRIPE_SECRET_KEY=

# Webhook signing secret for this app's /api/stripe/webhook endpoint.
# This is endpoint-specific and should not be copied from pacemaker-apply.
STRIPE_WEBHOOK_SECRET=

# Jira CLI. Shared project values are filled in; set your own email and API token.
JIRA_BASE_URL=https://pacemakerca.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PACE
JIRA_BOARD_ID=1

# OpenRouter API Key for automated commits (git-cm)
OPENROUTER_API_KEY=
